# Vault Key Encryption Key (KEK) provider: local | vault-transit | aws-kms | pkcs11
# - local: AES key from PAM_MASTER_KEY below (DEV/TEST ONLY — key sits in env)
# - vault-transit: HashiCorp Vault Transit over HTTPS (production, vendor-aligned)
# - aws-kms: AWS KMS (production; the key never leaves KMS)
# - pkcs11: on-prem HSM via a PKCS#11 module (needs the pkcs11-tagged build /
#           Dockerfile.pkcs11 — the default static image omits it)
PAM_KEK_PROVIDER=local

# local KEK: master key (32 bytes, urlsafe base64). Generate with:
#   go run ./cmd/pam-server -genkey        (or: ./pam-server -genkey)
PAM_MASTER_KEY=

# vault-transit KEK (production): the KEK never leaves Vault
# PAM_KEK_TRANSIT_ADDR=https://vault.internal:8200
# PAM_KEK_TRANSIT_TOKEN=s.xxxxxxxx
# PAM_KEK_TRANSIT_KEY=pamv1

# aws-kms KEK (production): set PAM_KEK_PROVIDER=aws-kms; uses the AWS credential chain
# PAM_KEK_AWS_KEY_ID=arn:aws:kms:eu-west-1:123456789012:key/abcd-...
# PAM_KEK_AWS_REGION=eu-west-1

# pkcs11 KEK (on-prem HSM): set PAM_KEK_PROVIDER=pkcs11. Only works in the
# pkcs11-tagged build (go build -tags pkcs11 / Dockerfile.pkcs11). The AES
# wrapping key lives in the HSM, found by its label; the key never leaves the token.
# PAM_KEK_PKCS11_MODULE=/usr/lib/softhsm/libsofthsm2.so
# PAM_KEK_PKCS11_PIN=1234
# PAM_KEK_PKCS11_KEY_LABEL=pamv1-kek
# PAM_KEK_PKCS11_TOKEN_LABEL=pamv1        # optional; first token if empty

# Admin API key (sent as X-API-Key header / portal Sign On). It is also the SSH/DB
# proxy password, so treat it like a root credential. Must be >=16 chars on a real
# database (set PAM_ALLOW_WEAK_API_KEY=true to override for demos).
PAM_API_KEY=
# PAM_ALLOW_WEAK_API_KEY=false

# --- Optional: source the bootstrap secrets from CyberArk Conjur (Phase 18) ---
# An alternative to SOPS: when PAM_CONJUR_URL is set, pamv1 fetches any EMPTY
# bootstrap secret (PAM_MASTER_KEY / PAM_API_KEY / PAM_DATABASE_URL / break-glass
# hash / broker keys) from Conjur at startup. An explicit env value always wins.
# See deploy/k8s/conjur/. Leave PAM_CONJUR_URL empty to use SOPS/env (the default).
# PAM_SECRETS_PROVIDER selects the provider explicitly; setting it to "conjur"
# makes PAM_CONJUR_URL required rather than optional, so a misconfigured deploy
# fails loudly instead of quietly falling back to env vars.
# PAM_SECRETS_PROVIDER=conjur
# PAM_CONJUR_URL=https://conjur.example
# PAM_CONJUR_ACCOUNT=default
# PAM_CONJUR_POLICY_PREFIX=pamv1
# authn-api-key:
# PAM_CONJUR_AUTHN_LOGIN=host/pamv1/pam-server
# PAM_CONJUR_API_KEY=
# authn-jwt (Kubernetes-native, no bootstrap secret in Git):
# PAM_CONJUR_AUTHN_JWT_SERVICE_ID=kubernetes
# PAM_CONJUR_JWT_FILE=/var/run/secrets/conjur/token
# PAM_CONJUR_CACERT=/etc/conjur/ca.pem       # PEM CA bundle for TLS to Conjur

# Optional break-glass: SHA-256 hex of the sealed emergency key. Generate with:
#   echo -n "the-emergency-key" | ./pam-server -hashkey
# Keep the plaintext key sealed offline; only the hash lives here.
PAM_BREAK_GLASS_KEY_HASH=

# Database: PostgreSQL (production) or "memory" (ephemeral demo)
PAM_DATABASE_URL=postgres://pam:CHANGE_ME@127.0.0.1:5432/pam?sslmode=disable

# docker-compose only: password for the bundled hardened Postgres
POSTGRES_PASSWORD=

# HTTP listen address (default :8080)
# PAM_LISTEN_ADDR=:8080

# Native HTTPS (TLS 1.2+): set both to serve TLS directly instead of behind an ingress.
# PAM_TLS_CERT=/etc/pamv1/tls.crt
# PAM_TLS_KEY=/etc/pamv1/tls.key

# Fail-closed transport: refuse to start over plaintext HTTP unless native TLS
# (above) is set. Leave off only behind a trusted TLS-terminating reverse proxy.
# PAM_REQUIRE_HTTPS=false
# Trusted reverse-proxy hops: makes the auth rate limiter read the real client IP
# from X-Forwarded-For (0 = key on RemoteAddr, spoof-proof).
# PAM_TRUSTED_PROXY_HOPS=0

# Rate limit for auth endpoints (login / OIDC callback / MFA verify), attempts
# per client IP per minute; 0 disables. Default 20. The same budget also throttles
# FAILED bearer credentials (X-API-Key, agent key, application key) on their own
# window, and each admitted failure is audited as api.auth_failed.
# PAM_AUTH_RATE_LIMIT=20
# Failed-auth throttle for the SSH (:2222) and DB (:5433) proxies, per source IP
# per minute; 0 disables. Default 10. Limits guessing of PAM_API_KEY.
# PAM_PROXY_AUTH_RATE_LIMIT=10

# Make credential reveal break-glass-only (force the recorded proxy path).
# PAM_REVEAL_DISABLED=true

# Tamper-evident PRIMARY audit trail: a base64 32-byte HMAC key that chains every
# audit event (any edit/reorder/delete becomes detectable via GET /api/audit/verify).
# Keep it OUT of the database (secret manager / env). Unset = plain audit table.
#   PAM_AUDIT_HMAC_KEY=$(openssl rand -base64 32)
# PAM_AUDIT_HMAC_KEY=
# ed25519 seed (base64 32 bytes; needs PAM_AUDIT_HMAC_KEY) for SIGNED checkpoints
# via GET /api/audit/head — lets an auditor detect tail truncation (deleting the
# newest events), which the HMAC chain alone can't. Archive checkpoints out-of-band.
#   PAM_AUDIT_SIGN_SEED=$(openssl rand -base64 32)
# PAM_AUDIT_SIGN_SEED=
# Continuous audit→SIEM forwarding (Phase 35): stream every audit event to a
# collector as RFC 5424 syslog, ArcSight CEF or QRadar LEEF. Empty
# PAM_AUDIT_FORWARD_ADDR = disabled.
# PAM_AUDIT_FORWARD_ADDR=siem.internal:514
# PAM_AUDIT_FORWARD_PROTO=udp            # udp | tcp | tls (Phase 47)
# PAM_AUDIT_FORWARD_FORMAT=rfc5424       # rfc5424 | cef | leef (Phase 47)
# PAM_AUDIT_FORWARD_INTERVAL_SEC=10
# With PROTO=tls the collector's certificate is ALWAYS verified (there is no
# insecure switch — this stream is your evidence). Pin its CA with a PEM bundle,
# or leave empty to verify against the system roots. Syslog is then framed
# octet-counted per RFC 5425; CEF/LEEF stay newline-delimited.
# PAM_AUDIT_FORWARD_CA=/data/siem-ca.pem
# Retention (Phase 36): prune recordings / audit rows older than N days (0 = keep
# forever). Audit pruning is skipped while the HMAC chain (PAM_AUDIT_HMAC_KEY) is on.
# PAM_RECORDING_RETENTION_DAYS=90
# PAM_AUDIT_RETENTION_DAYS=365
# PAM_RETENTION_INTERVAL_HOURS=24
# Archive BEFORE pruning (Phase 49): aged audit rows are exported as
# digest-stamped JSON Lines and aged recordings are MOVED here (written once,
# mode 0400) — and the delete runs ONLY if that archive succeeded, so a full or
# unwritable archive costs disk space rather than evidence. Point it at
# write-once storage. NOTE: the pamv1 container runs read-only with just /data
# writable, so mount your WORM volume and use a path beneath it.
# PAM_RETENTION_ARCHIVE_DIR=/data/worm

# Break-glass v2: M-of-N quorum unseal. Set the threshold (M) to enable
# POST /api/breakglass/unseal; split the key into N shares offline with:
#   echo -n "<emergency-key>" | PAM_BREAK_GLASS_SHARES=5 PAM_BREAK_GLASS_THRESHOLD=3 ./pam-server -split-key
# PAM_BREAK_GLASS_THRESHOLD=3
# PAM_BREAK_GLASS_SHARES=5
# PAM_BREAK_GLASS_TTL_MIN=15          # unsealed session lifetime (minutes)

# Real-time alerts on every break-glass access/unseal and approval decision.
# Any combination of channels can be set (they fan out); air-gap mode disables all.
# PAM_ALERT_WEBHOOK=https://hooks.example.com/pamv1
# PAM_ALERT_SYSLOG=udp://syslog.internal:514        # or tcp://…
# PAM_ALERT_EMAIL_SMTP=smtp.internal:25
# PAM_ALERT_EMAIL_FROM=pamv1@example.com
# PAM_ALERT_EMAIL_TO=soc@example.com,oncall@example.com
# PAM_ALERT_EMAIL_USER=                             # optional SMTP auth
# PAM_ALERT_EMAIL_PASS=

# SSH session proxy (default :2222; set to "off" to disable)
# PAM_SSH_ADDR=:2222
# PostgreSQL session proxy (Phase 15; default "off"). Operators reach postgres
# targets with:  psql "host=pam port=5433 user=<dbcred>@<target> dbname=<db>"
# and their PAM key as the password. Each SQL statement is audited (db.query).
# PAM_DB_ADDR=:5433
# Verify the UPSTREAM PostgreSQL server certificate (target leg) so the injected
# DB credential can't be MITM'd: pin a CA bundle, or verify against system roots.
# PAM_DB_UPSTREAM_CA=/etc/pamv1/db-upstream-ca.pem
# PAM_DB_UPSTREAM_TLS_VERIFY=false
# Refuse to start the DB proxy without TLS on the operator-facing leg (so the PAM
# key is never sent to it in cleartext); needs PAM_TLS_CERT/KEY.
# PAM_REQUIRE_DB_CLIENT_TLS=false
# Persist the proxy host key (PEM); empty = ephemeral key regenerated each start
# PAM_SSH_HOST_KEY=/data/ssh_host_key
# SFTP file-transfer policy (Phase 32): allow (forward + audit every operation),
# readonly (refuse uploads/deletes/renames), or deny (refuse the SFTP subsystem).
# PAM_SSH_SFTP=allow
# Deny SFTP by PATH as well as by operation (Phase 51): a regex file, one pattern
# per line, '#' comments — same format as PAM_COMMAND_DENY_FILE. A matching path
# is refused in EVERY mode, downloads included, and on both sides of a rename;
# blocked operations are audited `sftp.blocked … reason:path-denied` with the
# rule that matched. Patterns are regexes, not globs: write \.pem$ not *.pem
# PAM_SSH_SFTP_DENY_FILE=/data/sftp-deny.txt
# Zero Standing Privilege (Phase 22): give pamv1 an SSH certificate-authority key
# (created on first use, keep it persistent). An "ssh_ca" credential then stores
# NO secret — the proxy mints a short-lived certificate just-in-time per session.
# Install the CA on each target's TrustedUserCAKeys (fetch it from GET /api/ca/ssh).
# PAM_SSH_CA_KEY=/data/pamv1_ssh_ca
# PAM_SSH_CERT_TTL_MIN=2               # minted certificate validity (minutes)
# Operator-issued certificates (Phase 28): an operator proves possession of their
# own key (POST /api/ca/ssh/challenge -> /sign) and uses the cert with their normal
# SSH client. This caps how long such a certificate may live.
# PAM_SSH_OPERATOR_CERT_TTL_MIN=10
# Pin upstream TARGET host keys with an OpenSSH known_hosts file (recommended).
# Empty = trust any upstream key (insecure; the proxy logs a warning at startup).
# PAM_SSH_KNOWN_HOSTS=/data/known_hosts
# Reach SSH targets through an SSH bastion / jump host (legacy/segmented networks).
# PAM_SSH_JUMP_HOST=bastion.internal:22
# PAM_SSH_JUMP_USER=jump
# PAM_SSH_JUMP_KEY=/data/jump_key        # PEM private key for the bastion
# Where session recordings are written
# PAM_RECORDING_DIR=recordings
# Seal recordings and WinRM transcripts AT REST (Phase 41): each is encrypted with
# its own AES-256-GCM data key, wrapped by whichever KEK you configured above, so
# the artifact holding what the operator typed and saw is protected like a
# credential. Replay through the portal/API is unaffected (it decrypts, and detects
# the format per file so older recordings still play); the trade is that a .cast can
# no longer be fed straight to asciinema.
# PAM_RECORDING_ENCRYPT=true
# Sealing protects the CONTENT; by default the file NAME still carries the target
# and the actor, so a backup or snapshot of the recording volume reveals who
# reached which system. Turn this on (Phase 48) and recordings are named
# <timestamp>_<random hex> instead — the mapping moves into the audited
# session.record / winrm.run event, where reading it needs read_audit, the same
# gate as replaying. The console resolves it back, so menu 19 still shows target
# and actor. Set both flags to cover content and metadata.
# PAM_RECORDING_OPAQUE_NAMES=true

# Operational logging (to stdout). Level: debug|info|warn|error. Format: json|text
# PAM_LOG_LEVEL=info
# PAM_LOG_FORMAT=json

# Require a confirmed TOTP second factor for every password login. Users without
# MFA get an enrollment-only session until they set it up.
# PAM_MFA_REQUIRED=true

# OT / industrial hardening (Phase 8). See docs/OT-DEPLOYMENT.md.
# Gate every target's connect paths behind an approved access request (4-eyes /
# maintenance window). Per-target: set "require_approval":true on the target.
# PAM_REQUIRE_APPROVAL=true            # global: every target requires approval
# PAM_APPROVAL_WINDOW_MIN=60           # how long an approval stays valid
# ITSM / ticketing gate (Phase 20): require a change/incident ticket on access
# requests, validated by a regex and/or a webhook the ITSM answers 2xx for valid.
# PAM_REQUIRE_TICKET=true
# PAM_TICKET_PATTERN=^(CHG|INC)[0-9]{4,}$
# PAM_TICKET_VALIDATE_URL=https://itsm.example/api/validate-change   # POST {"ticket":"..."}
# Richer approval workflows (Phase 21): default number of distinct approvers an
# access request needs (multi-tier chains; a request may ask for more), and
# whether a reason is mandatory. Scheduled windows are per-request (not_before/after).
# PAM_APPROVALS_REQUIRED=2
# PAM_REQUIRE_REASON=true
# One-time access (Phase 26): make EVERY access request single-use — the first
# privileged use its approval admits consumes it (audited access.consumed).
# A request can also opt in individually with "one_time":true.
# PAM_ACCESS_ONE_TIME=true
# Air-gap mode: disable ALL outbound calls (alert webhooks) for isolated sites.
# PAM_OT_AIRGAP=true
# Air-gap is default-deny: with it set, pam-server REFUSES TO START alongside any
# integration that would reach the network. Name the ones that resolve inside your
# enclave to re-permit them individually (aws-kms and Entra have no exception).
# PAM_OT_AIRGAP_ALLOW=PAM_AUDIT_FORWARD_ADDR,PAM_CONJUR_URL
# Restrict which target protocols may be created/connected (comma-separated);
# empty = all. Use it to forbid e.g. RDP in an OT zone.
# PAM_ALLOWED_PROTOCOLS=ssh,winrm
# Command control (Phase 16): a file of regex patterns (one per line, '#'
# comments) that block matching commands on EVERY path where pamv1 sees a discrete
# command: SSH exec, the WinRM command loop, PostgreSQL statements, the REST
# POST /api/targets/{id}/winrm, and the agent broker's ssh_exec/winrm_exec tools.
# (An interactive SSH shell streams an unparsed PTY — not a containment boundary.)
# A blocked command is refused and audited (command.blocked). Empty = disabled.
# PAM_COMMAND_DENY_FILE=/data/command-deny.txt
# In-session step-up (Phase 30): a file of regex patterns (same format) marking
# PostgreSQL statements that PAUSE for a supervisor's live decision instead of
# being blocked outright — the session stays open either way. Decide via
# GET /api/sessions/stepups + POST /api/sessions/{id}/stepup.
# PAM_DB_STEPUP_FILE=/data/db-stepup.txt
# PAM_DB_STEPUP_TTL_SEC=120            # how long a paused statement waits

# Third-party vendor access gate (Phase 29): an external technician reaches a
# target only while a customer-approved, in-window contract grant is active.
# The attestation webhook is consulted at approval time — the vendor-management
# system answers 2xx for a currently-employed technician.
# PAM_VENDOR_ATTEST_URL=https://vendors.example/api/attest   # POST {"vendor":"...","org":"..."}
# PAM_VENDOR_SWEEP_INTERVAL_MIN=5      # cut live sessions when a grant window closes (0 = off)

# Privileged threat analytics (Phase 23): behavioral risk scoring over the audit
# trail. GET /api/analytics/risk is always available (CapReadAudit). Set the worker
# interval to score continuously and alert on / respond to high-risk actors.
# PAM_ANALYTICS_INTERVAL_MIN=5         # 0 = worker off (endpoint stays on)
# PAM_ANALYTICS_WINDOW_MIN=60          # how far back each scoring pass looks
# PAM_ANALYTICS_AUTO_KILL=true         # terminate a CRITICAL actor's live sessions
# PAM_ANALYTICS_BUSINESS_START=7       # business hours for the off-hours signal…
# PAM_ANALYTICS_BUSINESS_END=20        # …outside 07:00–20:00 or on a weekend = off-hours
# Audit timestamps are UTC; set the timezone the business hours are interpreted in
# (an IANA name). Empty = UTC. A high-risk actor is re-alerted at most once per
# PAM_ANALYTICS_WINDOW_MIN so a sustained incident isn't suppressed forever.
# PAM_ANALYTICS_TIMEZONE=America/New_York

# Application-secrets API (Phase 24, Tier-4): a Conjur-style path where a non-agent
# application retrieves the specific secrets it was granted with a bearer key
# (GET /v1/app-secrets/{credential_id}). Default-deny; front it with TLS since it
# delivers plaintext to machines. Off by default.
# PAM_APP_SECRETS_ENABLED=true

# Credential-lifecycle worker (Phase 7). Set the interval (minutes) to enable a
# background pass that reconciles every credential (detects out-of-sync/drift)
# and rotates password credentials older than the max age. 0 = disabled.
# PAM_ROTATE_INTERVAL_MIN=60
# PAM_ROTATE_MAX_AGE_HOURS=168      # rotate secrets older than 7 days; 0 = report only
# Rotate a credential as soon as a proxied SSH session using it ends, so a secret
# used in one session can't be reused in the next:
# PAM_ROTATE_AFTER_SESSION=true
# Refuse a proxied session if its recording can't be created (fail-closed audit),
# instead of proceeding unrecorded:
# PAM_REQUIRE_RECORDING=true
# Resource-exhaustion limits (0 = unlimited). Cap concurrent live proxied sessions
# per user and overall (checked before any secret is decrypted; per-replica), and
# cap a single recording's output so one runaway session can't fill the disk (the
# session is terminated when it hits the cap).
# PAM_MAX_SESSIONS_PER_USER=0
# PAM_MAX_SESSIONS_TOTAL=0
# PAM_MAX_RECORDING_MB=0
# Rotation/reconciliation connectors run over SSH (chpasswd) and WinRM (net user).
# Manual: POST /api/credentials/{id}/rotate, POST /api/credentials/{id}/reconcile
#         [?remediate=true], GET /api/reconcile (read-only drift scan).
# Credential checkout leases (POST /api/credentials/{id}/checkout|checkin): the
# secret is returned for the lease, then rotated on check-in.
# PAM_CHECKOUT_TTL_MIN=30           # checkout lease lifetime (minutes)

# Windows / WinRM command execution. HTTPS (port 5986) by default.
# PAM_WINRM_HTTPS=true
# PAM_WINRM_INSECURE_SKIP_VERIFY=false   # dev only
# PAM_WINRM_AUTH=ntlm                    # basic (default) or ntlm (AD-joined hosts)
# Interactive WinRM command loop through the SSH proxy (ssh cred@wintarget@pam).
# Each line runs as a separate WinRM command (not a stateful PowerShell).
# PAM_PROXY_WINRM=true

# RDP brokering via Apache Guacamole. Set the guacd address to enable
# GET /api/targets/{id}/rdp (a WebSocket tunnel; credentials injected into guacd).
# PAM_GUACD_ADDR=127.0.0.1:4822
# Make guacd record RDP sessions server-side (a path on the guacd host):
# PAM_GUACD_RECORDING_PATH=/recordings
# RDP security: by default guacd negotiates the mode and VERIFIES the server
# certificate. Override the mode (nla|tls|rdp) and only disable verification for
# self-signed/dev hosts:
# PAM_GUACD_RDP_SECURITY=nla
# PAM_GUACD_IGNORE_CERT=true          # dev only — skips RDP server-cert verification
# RDP clipboard policy (Phase 33): allow (copy+paste on), readonly (block paste
# into the target), or deny (clipboard off both ways). Drive redirection always off.
# PAM_RDP_CLIPBOARD=allow
# Audit what actually crosses that bridge (Phase 50): meta records direction
# (out = copied from the target, in = pasted into it), mimetype, byte count and
# SHA-256 as `rdp.clipboard`; full also records the content, truncated. Content
# is opt-in on purpose — a privileged desktop's clipboard routinely holds a
# password the operator just copied, and the audit trail is auditor-readable.
# PAM_RDP_CLIPBOARD_AUDIT=meta          # off | meta | full

# OIDC single sign-on (Authorization Code + PKCE). Set PAM_OIDC_ISSUER to enable.
# The IdP performs the login (its MFA / Conditional Access apply). For Entra:
#   issuer = https://login.microsoftonline.com/<tenant>/v2.0
# PAM_OIDC_ISSUER=
# PAM_OIDC_CLIENT_ID=
# PAM_OIDC_CLIENT_SECRET=
# PAM_OIDC_REDIRECT_URL=https://pam.example.com/api/auth/oidc/callback
# PAM_OIDC_SCOPES=openid profile
# Auth/token/JWKS endpoints are auto-discovered from the issuer; override if needed:
# PAM_OIDC_AUTH_URL=   PAM_OIDC_TOKEN_URL=   PAM_OIDC_JWKS_URL=
# Map OIDC app-role values / group ids to the four roles:
# PAM_OIDC_ROLE_ADMIN=pam.admin
# PAM_OIDC_ROLE_USER=pam.user
# PAM_OIDC_ROLE_AUDITOR=pam.auditor
# PAM_OIDC_ROLE_APPROVER=pam.approver
# Where the callback sends the browser back (portal base):
# PAM_PORTAL_URL=/

# Active Directory / LDAP login (optional). Set PAM_LDAP_URL to enable /api/login.
# Use ldaps:// (secure) — plain ldap:// only in isolated dev.
# PAM_LDAP_URL=ldaps://dc.example.com:636
# PAM_LDAP_BIND_DN=CN=svc-pam,OU=Service,DC=example,DC=com
# PAM_LDAP_BIND_PASSWORD=
# PAM_LDAP_BASE_DN=DC=example,DC=com
# PAM_LDAP_USER_FILTER=(sAMAccountName=%s)
# PAM_LDAP_INSECURE_SKIP_VERIFY=false
# Map AD group DNs to the four roles (highest privilege wins):
# PAM_LDAP_GROUP_ADMIN=CN=PAM-Admins,OU=Groups,DC=example,DC=com
# PAM_LDAP_GROUP_USER=CN=PAM-Users,OU=Groups,DC=example,DC=com
# PAM_LDAP_GROUP_AUDITOR=CN=PAM-Auditors,OU=Groups,DC=example,DC=com
# PAM_LDAP_GROUP_APPROVER=CN=PAM-Approvers,OU=Groups,DC=example,DC=com

# Microsoft Entra ID (Azure AD) login (optional). Set PAM_ENTRA_TENANT_ID to enable.
# Uses the OAuth2 resource-owner-password grant; pair with pamv1's TOTP MFA.
# PAM_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# PAM_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# PAM_ENTRA_CLIENT_SECRET=
# PAM_ENTRA_SCOPE=                       # default "<client-id>/.default"
# PAM_ENTRA_AUTHORITY_HOST=login.microsoftonline.com   # or a sovereign cloud host
# Map Entra app-role values (or group object ids) to the four roles:
# PAM_ENTRA_ROLE_ADMIN=pam.admin
# PAM_ENTRA_ROLE_USER=pam.user
# PAM_ENTRA_ROLE_AUDITOR=pam.auditor
# PAM_ENTRA_ROLE_APPROVER=pam.approver

# AI-agent access broker (Phase 13, optional). Setting the policy file enables the
# broker. The audit-chain keys may be left unset: each is then generated once and
# held under shared custody (sealed by the KEK in the database's key_material,
# shared by every replica, re-wrapped by -rotate-kek). Set them explicitly
# (base64 of 32 random bytes, e.g. `openssl rand -base64 32`) to hold them
# yourself — an explicit value wins, and is how a signer rotation is driven.
# PAM_BROKER_POLICY_FILE=/etc/pamv1/broker-policy.yaml
# PAM_BROKER_AUDIT_KEY=                  # base64 32-byte HMAC key for the audit chain (unset = shared custody)
# PAM_BROKER_AUDIT_SIGN_SEED=            # base64 32-byte ed25519 seed for signed checkpoints (unset = shared custody)
# Periodic IN-CHAIN signed checkpoints (Phase 27): every N broker events the chain
# appends a signed checkpoint over its running head — defense in depth over the
# HMAC, since forging it needs the signing key too. Rotate the signing key by
# moving the retired PUBLIC key(s) into _SIGN_PREV (comma-separated, base64); both
# are published at GET /v1/audit/jwks so an archived checkpoint still verifies.
# PAM_BROKER_AUDIT_CHECKPOINT_EVERY=100  # 0 = off
# PAM_BROKER_AUDIT_SIGN_PREV=
# PAM_BROKER_TOKEN_TTL_MIN=15            # lifetime of a single-use approval resume token
# PAM_BROKER_MAX_ARG_BYTES=16384         # cap on a tool call's serialized arguments (0 = off)
# PAM_BROKER_RATE_PER_MIN=0              # per-agent tool-call rate limit (0 = off)
# --- SPIFFE JWT-SVID agent identity (optional; accepted alongside static keys) ---
# PAM_BROKER_TRUST_DOMAIN_JWKS=/etc/pamv1/trust-domain-jwks.json  # enables SVIDs
# PAM_BROKER_TRUST_DOMAIN=example.org    # SPIFFE trust domain host (required with the JWKS)
# PAM_BROKER_AUDIENCE=pam-broker         # required SVID audience (required with the JWKS)
# PAM_BROKER_MAX_DELEGATION_DEPTH=1      # RFC 8693 act-chain depth cap
