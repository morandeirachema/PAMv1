# Optional image with the PKCS#11 HSM KEK provider (PAM_KEK_PROVIDER=pkcs11).
#
# Unlike the default Dockerfile (CGO_ENABLED=0, static, distroless/static), this
# build needs cgo and a dynamic loader to dlopen the vendor PKCS#11 module at
# runtime, so it uses a glibc base (distroless/base). The HSM's PKCS#11 .so must
# be present in the container (mount it and set PAM_KEK_PKCS11_MODULE to its path).
#
#   docker build -f deploy/docker/Dockerfile.pkcs11 -t pamv1:pkcs11 .   # run from the repo root
#
# It stays hardened: non-root, and (unlike the default) NOT read-only-root only
# because the vendor module may need to load — mount just the module read-only.
#
# Base images are pinned by digest for the same reason as the default image; see
# the comment there.

FROM golang:1.27-bookworm@sha256:ded31c68586d2e49e760acc2e65a884b23d032e9bbbed0ae0c55abd3fcaf4452 AS build
# Stamped exactly as the default image stamps them. Without these the PKCS#11
# build reported `pam-server dev (none)` from `-version`, from the startup log
# and from the pam_build_info metric — so the one deployment flavour used with an
# HSM, the most security-sensitive of them, was also the one that could not tell
# an operator or a dashboard which build was running.
ARG VERSION=dev
ARG COMMIT=none
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download
COPY . .
# libltdl is what most PKCS#11 modules dlopen through; cgo links the loader.
# The build cache is keyed separately from the default image's by its own mount
# id, because these objects are cgo-enabled and must not be mixed with the
# static build's.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,id=go-build-pkcs11,sharing=locked \
    CGO_ENABLED=1 go build -tags pkcs11 -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/pam-server ./cmd/pam-server

FROM gcr.io/distroless/base-debian12:nonroot@sha256:7f0c72cd138b442ae0deeb69c08b1acf5525439ba251a49ad93c320a061567e5
COPY --from=build /out/pam-server /pam-server
# The portal/API, the SSH proxy, and the PostgreSQL and SQL Server proxies —
# the last two only when PAM_DB_ADDR / PAM_MSSQL_ADDR are set (both default off).
EXPOSE 8080 2222 5433 1433
# Numeric UID (distroless nonroot = 65532) so Kubernetes runAsNonRoot can verify
# the container is non-root without resolving a username.
USER 65532:65532
# Distroless has no shell/curl, so probe via the binary's own -healthcheck flag.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
	CMD ["/pam-server", "-healthcheck"]
ENTRYPOINT ["/pam-server"]
