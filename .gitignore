/pam-server
*.test
coverage.out
dist/
.env
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# SOPS / age private keys — never commit a real one (the demo example is kept).
# *.key is deliberately broad: the SOPS README tells you to run `age-keygen -o
# age.key`, and a reader who names theirs prod.key should not be caught out by a
# pattern that only matched the example filename.
*.key
*.agekey
age.key
keys.txt
!deploy/k8s/sops/age-example.key
# real (non-example) sealed secrets stay local unless you intend to commit them
deploy/k8s/sops/secrets.sops.yaml
